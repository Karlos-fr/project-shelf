---
// ============================================================================
// ShelfRoute — Page autonome « L'étagère », pré-générée dans chaque langue
// ----------------------------------------------------------------------------
// La vitrine ne contient plus l'étagère 3D : elle vit ici, à l'adresse /{langue}/shelf/,
// et le README du dépôt y renvoie. Le HTML reste complet sans JavaScript.
// ============================================================================
import BaseLayout from '../../layouts/BaseLayout.astro';
import ShelfPage from '../../components/ShelfPage.tsx';
import { loadSiteConfig } from '../../config/site.ts';
import { loadPublishedCatalogue } from '../../data/published.ts';
import { buildSeo } from '../../seo/model.ts';
import { MESSAGES } from '../../i18n/messages.ts';
import type { Locale } from '../../domain/locale.ts';

export function getStaticPaths() {
  return [{ params: { lang: 'en' } }, { params: { lang: 'fr' } }];
}

const locale = Astro.params.lang as Locale;
const config = loadSiteConfig(process.env);
const catalogue = await loadPublishedCatalogue();
const home = buildSeo(config, { locale, projectId: null, categories: [], sort: 'updated', q: '' });
// Même modèle que l'accueil, mais l'adresse canonique et les variantes pointent vers /shelf/.
const root = config.base.endsWith('/') ? config.base : config.base + '/';
function shelfUrl(lang: Locale): string {
  return new URL(root + lang + '/shelf/', config.origin + '/').href;
}
const seo = {
  ...home,
  title: MESSAGES[locale].shelfPageTitle,
  description: MESSAGES[locale].shelfLead,
  canonical: shelfUrl(locale),
  alternates: [
    { lang: 'en' as const, href: shelfUrl('en') },
    { lang: 'fr' as const, href: shelfUrl('fr') },
    { lang: 'x-default' as const, href: shelfUrl('en') },
  ],
};
---
<BaseLayout seo={seo}>
  <ShelfPage client:load config={config} summaries={catalogue.summaries} locale={locale} />
</BaseLayout>
